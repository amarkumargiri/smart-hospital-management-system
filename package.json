{
  "name": "smart-hospital-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Smart Hospital Management, Patient Care & Forecasting Platform",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "setup": "npm install && npm run db:reset --workspace=server",
    "db:reset": "npm run db:reset --workspace=server",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
