# Copy to .env before running the server.
# For production: point DATABASE_URL at PostgreSQL, change the provider in
# prisma/schema.prisma to postgresql, set a real JWT_SECRET, and turn off OTP_DEV_MODE.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30m"
REFRESH_EXPIRES_DAYS=30
PORT=4000
NODE_ENV=development
OTP_DEV_MODE=true
UPLOAD_DIR="./uploads"
# CORS_ORIGIN="https://your-frontend-domain"
